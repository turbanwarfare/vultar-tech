--!nocheck
return function()
	local AmmoManager = require(script.Parent.AmmoManager)

	describe("AmmoManager", function()
		beforeEach(function()
			AmmoManager.cleanup()
		end)

		afterEach(function()
			AmmoManager.cleanup()
		end)

		describe("module structure", function()
			it("should have getGunIndex function", function()
				expect(typeof(AmmoManager.getGunIndex)).to.equal("function")
			end)

			it("should have getStoredAmmo function", function()
				expect(typeof(AmmoManager.getStoredAmmo)).to.equal("function")
			end)

			it("should have storeAmmo function", function()
				expect(typeof(AmmoManager.storeAmmo)).to.equal("function")
			end)

			it("should have clearStoredAmmo function", function()
				expect(typeof(AmmoManager.clearStoredAmmo)).to.equal("function")
			end)

			it("should have isBackgroundRecharging function", function()
				expect(typeof(AmmoManager.isBackgroundRecharging)).to.equal("function")
			end)

			it("should have cancelBackgroundRecharge function", function()
				expect(typeof(AmmoManager.cancelBackgroundRecharge)).to.equal("function")
			end)

			it("should have startBackgroundRecharge function", function()
				expect(typeof(AmmoManager.startBackgroundRecharge)).to.equal("function")
			end)

			it("should have cleanup function", function()
				expect(typeof(AmmoManager.cleanup)).to.equal("function")
			end)
		end)

		describe("getGunIndex", function()
			it("should return 1 for H-82", function()
				expect(AmmoManager.getGunIndex("H-82")).to.equal(1)
			end)

			it("should return 2 for BR-16", function()
				expect(AmmoManager.getGunIndex("BR-16")).to.equal(2)
			end)

			it("should return 3 for Medi+", function()
				expect(AmmoManager.getGunIndex("Medi+")).to.equal(3)
			end)

			it("should return 1 for unknown gun", function()
				expect(AmmoManager.getGunIndex("UnknownGun")).to.equal(1)
			end)

			it("should return 1 for empty string", function()
				expect(AmmoManager.getGunIndex("")).to.equal(1)
			end)
		end)

		describe("ammo storage", function()
			it("should return maxAmmo when no stored ammo exists", function()
				local ammo = AmmoManager.getStoredAmmo("TestGun", 100)
				expect(ammo).to.equal(100)
			end)

			it("should store and retrieve ammo", function()
				AmmoManager.storeAmmo("TestGun", 50)
				local ammo = AmmoManager.getStoredAmmo("TestGun", 100)
				expect(ammo).to.equal(50)
			end)

			it("should store zero ammo", function()
				AmmoManager.storeAmmo("TestGun", 0)
				local ammo = AmmoManager.getStoredAmmo("TestGun", 100)
				expect(ammo).to.equal(0)
			end)

			it("should store different guns independently", function()
				AmmoManager.storeAmmo("Gun1", 25)
				AmmoManager.storeAmmo("Gun2", 75)
				expect(AmmoManager.getStoredAmmo("Gun1", 100)).to.equal(25)
				expect(AmmoManager.getStoredAmmo("Gun2", 100)).to.equal(75)
			end)

			it("should overwrite existing ammo", function()
				AmmoManager.storeAmmo("TestGun", 50)
				AmmoManager.storeAmmo("TestGun", 30)
				expect(AmmoManager.getStoredAmmo("TestGun", 100)).to.equal(30)
			end)

			it("should clear all stored ammo", function()
				AmmoManager.storeAmmo("Gun1", 25)
				AmmoManager.storeAmmo("Gun2", 75)
				AmmoManager.clearStoredAmmo()
				expect(AmmoManager.getStoredAmmo("Gun1", 100)).to.equal(100)
				expect(AmmoManager.getStoredAmmo("Gun2", 100)).to.equal(100)
			end)
		end)

		describe("background recharge", function()
			it("should not be recharging by default", function()
				expect(AmmoManager.isBackgroundRecharging("TestGun")).to.equal(false)
			end)

			it("should report recharging after start", function()
				AmmoManager.storeAmmo("TestGun", 50)
				AmmoManager.startBackgroundRecharge("TestGun", 100, 10)
				expect(AmmoManager.isBackgroundRecharging("TestGun")).to.equal(true)
			end)

			it("should not report recharging for different gun", function()
				AmmoManager.storeAmmo("TestGun", 50)
				AmmoManager.startBackgroundRecharge("TestGun", 100, 10)
				expect(AmmoManager.isBackgroundRecharging("OtherGun")).to.equal(false)
			end)

			it("should cancel background recharge", function()
				AmmoManager.storeAmmo("TestGun", 50)
				AmmoManager.startBackgroundRecharge("TestGun", 100, 10)
				AmmoManager.cancelBackgroundRecharge()
				expect(AmmoManager.isBackgroundRecharging("TestGun")).to.equal(false)
			end)

			it("should cancel safely when not recharging", function()
				expect(function()
					AmmoManager.cancelBackgroundRecharge()
				end).never.to.throw()
			end)

			it("should replace existing recharge when starting new one", function()
				AmmoManager.storeAmmo("Gun1", 50)
				AmmoManager.storeAmmo("Gun2", 50)
				AmmoManager.startBackgroundRecharge("Gun1", 100, 10)
				AmmoManager.startBackgroundRecharge("Gun2", 100, 10)
				expect(AmmoManager.isBackgroundRecharging("Gun1")).to.equal(true)
				expect(AmmoManager.isBackgroundRecharging("Gun2")).to.equal(true)
			end)
		end)

		describe("cleanup", function()
			it("should clean up without error", function()
				expect(function()
					AmmoManager.cleanup()
				end).never.to.throw()
			end)

			it("should clear stored ammo on cleanup", function()
				AmmoManager.storeAmmo("TestGun", 50)
				AmmoManager.cleanup()
				expect(AmmoManager.getStoredAmmo("TestGun", 100)).to.equal(100)
			end)

			it("should cancel recharge on cleanup", function()
				AmmoManager.storeAmmo("TestGun", 50)
				AmmoManager.startBackgroundRecharge("TestGun", 100, 10)
				AmmoManager.cleanup()
				expect(AmmoManager.isBackgroundRecharging("TestGun")).to.equal(false)
			end)
		end)
	end)
end
