--!nocheck
return function()
	local PhaseConfig = require(script.Parent.PhaseConfig)

	describe("PhaseConfig", function()
		describe("constants", function()
			it("has 3 phases in order", function()
				expect(#PhaseConfig.PHASE_ORDER).to.equal(3)
				expect(PhaseConfig.PHASE_ORDER[1]).to.equal("phase1")
				expect(PhaseConfig.PHASE_ORDER[2]).to.equal("phase2")
				expect(PhaseConfig.PHASE_ORDER[3]).to.equal("phase3")
			end)

			it("has positive initial raid time", function()
				expect(PhaseConfig.INITIAL_RAID_TIME).to.equal(1800)
			end)

			it("has positive countdown time", function()
				expect(PhaseConfig.COUNTDOWN_TIME).to.equal(10)
			end)
		end)

		describe("getPhase", function()
			it("returns phase1 as terminal-only", function()
				local p = PhaseConfig.getPhase("phase1")
				expect(p).to.be.ok()
				expect(p.HasPayload).to.equal(false)
				expect(p.HasTerminal).to.equal(true)
				expect(p.TermTime).to.equal(360)
				expect(p.CaptureTime).to.equal(4)
				expect(p.RollbackRate).to.equal(2)
			end)

			it("returns phase2 with payload to TermNode1", function()
				local p = PhaseConfig.getPhase("phase2")
				expect(p).to.be.ok()
				expect(p.HasPayload).to.equal(true)
				expect(p.HasTerminal).to.equal(true)
				expect(p.PayloadStartNode).to.equal("Node1")
				expect(p.PayloadEndNode).to.equal("TermNode1")
				expect(p.PayloadSpeed).to.equal(7)
			end)

			it("returns phase3 with payload to TermNode2", function()
				local p = PhaseConfig.getPhase("phase3")
				expect(p).to.be.ok()
				expect(p.HasPayload).to.equal(true)
				expect(p.PayloadStartNode).to.equal("TermNode1")
				expect(p.PayloadEndNode).to.equal("TermNode2")
				expect(p.TermTime).to.equal(600)
				expect(p.RollbackRate).to.equal(3)
			end)

			it("returns nil for idle and ended", function()
				expect(PhaseConfig.getPhase("idle")).to.equal(nil)
				expect(PhaseConfig.getPhase("ended")).to.equal(nil)
			end)

			it("all phases have required fields", function()
				for _, phaseId in PhaseConfig.PHASE_ORDER do
					local p = PhaseConfig.getPhase(phaseId)
					expect(p).to.be.ok()
					expect(type(p.DisplayName)).to.equal("string")
					expect(type(p.SpawnFolder)).to.equal("string")
					expect(p.TermTime > 0).to.equal(true)
					expect(p.CaptureTime > 0).to.equal(true)
					expect(p.RollbackRate > 0).to.equal(true)
					expect(type(p.TimeGift)).to.equal("number")
				end
			end)

			it("payload phases have payload fields", function()
				for _, phaseId in { "phase2", "phase3" } do
					local p = PhaseConfig.getPhase(phaseId)
					expect(p.PayloadStartNode).to.be.ok()
					expect(p.PayloadEndNode).to.be.ok()
					expect(p.PayloadSpeed).to.be.ok()
					expect(p.EscortRange).to.be.ok()
				end
			end)
		end)

		describe("getNextPhase", function()
			it("phase1 -> phase2", function()
				expect(PhaseConfig.getNextPhase("phase1")).to.equal("phase2")
			end)
			it("phase2 -> phase3", function()
				expect(PhaseConfig.getNextPhase("phase2")).to.equal("phase3")
			end)
			it("phase3 -> nil (raiders win)", function()
				expect(PhaseConfig.getNextPhase("phase3")).to.equal(nil)
			end)
			it("idle -> nil", function()
				expect(PhaseConfig.getNextPhase("idle")).to.equal(nil)
			end)
			it("ended -> nil", function()
				expect(PhaseConfig.getNextPhase("ended")).to.equal(nil)
			end)
		end)

		describe("isValidPhase", function()
			it("returns true for phase1-3", function()
				expect(PhaseConfig.isValidPhase("phase1")).to.equal(true)
				expect(PhaseConfig.isValidPhase("phase2")).to.equal(true)
				expect(PhaseConfig.isValidPhase("phase3")).to.equal(true)
			end)
			it("returns false for idle and ended", function()
				expect(PhaseConfig.isValidPhase("idle")).to.equal(false)
				expect(PhaseConfig.isValidPhase("ended")).to.equal(false)
			end)
		end)

		describe("getSpawnFolder", function()
			it("returns correct folder names", function()
				expect(PhaseConfig.getSpawnFolder("phase1")).to.equal("Phase 1")
				expect(PhaseConfig.getSpawnFolder("phase2")).to.equal("Phase 2")
				expect(PhaseConfig.getSpawnFolder("phase3")).to.equal("Phase 3")
			end)
			it("returns nil for non-phases", function()
				expect(PhaseConfig.getSpawnFolder("idle")).to.equal(nil)
			end)
		end)
	end)
end
