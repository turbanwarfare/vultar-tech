--!nocheck
return function()
	local PlayerCache = require(script.Parent.PlayerCache)

	describe("PlayerCache", function()
		describe("getAll", function()
			it("should return a table", function()
				local all = PlayerCache.getAll()
				expect(typeof(all)).to.equal("table")
			end)
		end)

		describe("getCount", function()
			it("should return a number", function()
				local count = PlayerCache.getCount()
				expect(typeof(count)).to.equal("number")
				expect(count >= 0).to.equal(true)
			end)

			it("should match getAll length", function()
				local count = PlayerCache.getCount()
				local all = PlayerCache.getAll()
				expect(count).to.equal(#all)
			end)
		end)

		describe("getByExactName", function()
			it("should return nil for non-existent player", function()
				local result = PlayerCache.getByExactName("NonExistentPlayer12345678")
				expect(result).to.equal(nil)
			end)

			it("should be case insensitive", function()
				local lower = PlayerCache.getByExactName("testplayer")
				local upper = PlayerCache.getByExactName("TESTPLAYER")
				expect(lower).to.equal(upper)
			end)
		end)

		describe("getByUserId", function()
			it("should return nil for non-existent userId", function()
				local result = PlayerCache.getByUserId(-999999999)
				expect(result).to.equal(nil)
			end)
		end)

		describe("findByPrefix", function()
			it("should return nil for empty string", function()
				local result, matchedName = PlayerCache.findByPrefix("")
				expect(result).to.equal(nil)
				expect(matchedName).to.equal(nil)
			end)

			it("should return nil for nil input", function()
				local result, matchedName = PlayerCache.findByPrefix(nil :: any)
				expect(result).to.equal(nil)
				expect(matchedName).to.equal(nil)
			end)
		end)

		describe("findByPartial", function()
			it("should return nil for empty string", function()
				local result = PlayerCache.findByPartial("")
				expect(result).to.equal(nil)
			end)

			it("should return nil for nil input", function()
				local result = PlayerCache.findByPartial(nil :: any)
				expect(result).to.equal(nil)
			end)
		end)

		describe("CachedPlayer structure", function()
			it("should have correct fields when players exist", function()
				local all = PlayerCache.getAll()
				for _, cached in all do
					expect(cached.player).to.be.ok()
					expect(typeof(cached.name)).to.equal("string")
					expect(typeof(cached.lowerName)).to.equal("string")
					expect(typeof(cached.displayName)).to.equal("string")
					expect(typeof(cached.lowerDisplayName)).to.equal("string")
					expect(typeof(cached.userId)).to.equal("number")

					local expectedLowerName = string.lower(cached.name)
					local expectedLowerDisplayName = string.lower(cached.displayName)
					expect(cached.lowerName).to.equal(expectedLowerName)
					expect(cached.lowerDisplayName).to.equal(expectedLowerDisplayName)
				end
			end)
		end)
	end)
end
