function SerdesFunctions.Domination_ReadEVENT_Update(): ({ Official: boolean, Paused: boolean, CountingDown: boolean, DefenderScore: number, HostileScore: number, MaxScore: number, Points: { { Label: string, Owner: ("Defenders" | "Hostiles")?, Progress: number, ProgressOwner: ("Defenders" | "Hostiles")?, Contested: boolean } } })
	-- Read BLOCK: 16 bytes
	local BLOCK_START = Read(16)
	local Value = {} :: any
	Value.Official = (buffer.readu8(RecieveBuffer, BLOCK_START + 0) == 1)
	Value.Paused = (buffer.readu8(RecieveBuffer, BLOCK_START + 1) == 1)
	Value.CountingDown = (buffer.readu8(RecieveBuffer, BLOCK_START + 2) == 1)
	Value.DefenderScore = buffer.readi32(RecieveBuffer, BLOCK_START + 3)
	Value.HostileScore = buffer.readi32(RecieveBuffer, BLOCK_START + 7)
	Value.MaxScore = buffer.readi32(RecieveBuffer, BLOCK_START + 11)
	-- START ARRAY
	local Length = buffer.readu8(RecieveBuffer, BLOCK_START + 15)
	if Length < 0 then error(`Expected "Length" to be larger than 0, got {Length} instead.`) end
	if Length > 26 then error(`Expected "Length" to be smaller than 26, got {Length} instead.`) end
	Value.Points = table.create(Length)
		-- Read BLOCK: 9 bytes
	local ARRAY_START_1 = Read(9 * Length)
	for Index = 1, Length do
		local Item_1 = {} :: any
		-- Read 2
		local OPERATION_OFFSET_0 = ARRAY_START_1
		ARRAY_START_1 += 2
		Length = buffer.readu16(RecieveBuffer, OPERATION_OFFSET_0)
		Item_1.Label = buffer.readstring(RecieveBuffer, Read(Length), Length)
		-- Read 1
		local OPERATION_OFFSET_1 = ARRAY_START_1
		ARRAY_START_1 += 1
		if buffer.readu8(RecieveBuffer, OPERATION_OFFSET_1) == 1 then
			-- Read BLOCK: 1 bytes
			local BLOCK_START = Read(1)
			Item_1.Owner = true :: any
			local Index = buffer.readu8(RecieveBuffer, BLOCK_START + 0)
			if Index == 0 then
				Item_1.Owner = "Defenders"
			elseif Index == 1 then
				Item_1.Owner = "Hostiles"
			else
				error(`Unexpected enum: {Index}`)
			end
		end
		-- Read 4
		local OPERATION_OFFSET_2 = ARRAY_START_1
		ARRAY_START_1 += 4
		Item_1.Progress = buffer.readf32(RecieveBuffer, OPERATION_OFFSET_2)
		-- Read 1
		local OPERATION_OFFSET_3 = ARRAY_START_1
		ARRAY_START_1 += 1
		if buffer.readu8(RecieveBuffer, OPERATION_OFFSET_3) == 1 then
			-- Read BLOCK: 1 bytes
			local BLOCK_START = Read(1)
			Item_1.ProgressOwner = true :: any
			local Index = buffer.readu8(RecieveBuffer, BLOCK_START + 0)
			if Index == 0 then
				Item_1.ProgressOwner = "Defenders"
			elseif Index == 1 then
				Item_1.ProgressOwner = "Hostiles"
			else
				error(`Unexpected enum: {Index}`)
			end
		end
		-- Read 1
		local OPERATION_OFFSET_4 = ARRAY_START_1
		ARRAY_START_1 += 1
		Item_1.Contested = (buffer.readu8(RecieveBuffer, OPERATION_OFFSET_4) == 1)
		table.insert(Value.Points, Item_1)
	end
	-- END ARRAY
	return Value
end

