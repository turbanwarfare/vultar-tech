function SerdesFunctions.Domination_WriteEVENT_Control(Value: { action: ("start" | "pause" | "unpause" | "reset" | "setMaxScore" | "setScores"), maxScore: number?, defenderScore: number?, hostileScore: number? }): ()
	-- Allocate BLOCK: 5 bytes
	local BLOCK_START = Allocate(5)
	buffer.writeu8(SendBuffer, BLOCK_START + 0, 109)
	if Value.action == "start" then
		buffer.writeu8(SendBuffer, BLOCK_START + 1, 0)
	elseif Value.action == "pause" then
		buffer.writeu8(SendBuffer, BLOCK_START + 1, 1)
	elseif Value.action == "unpause" then
		buffer.writeu8(SendBuffer, BLOCK_START + 1, 2)
	elseif Value.action == "reset" then
		buffer.writeu8(SendBuffer, BLOCK_START + 1, 3)
	elseif Value.action == "setMaxScore" then
		buffer.writeu8(SendBuffer, BLOCK_START + 1, 4)
	elseif Value.action == "setScores" then
		buffer.writeu8(SendBuffer, BLOCK_START + 1, 5)
	else
		error(`Unexpected enum: {Value.action}, expected one of "start" or "pause" or "unpause" or "reset" or "setMaxScore" or "setScores".`)
	end
	buffer.writeu8(SendBuffer, BLOCK_START + 2, Value.maxScore ~= nil and 1 or 0)
	if Value.maxScore ~= nil then
		-- Allocate BLOCK: 4 bytes
		local BLOCK_START = Allocate(4)
		buffer.writei32(SendBuffer, BLOCK_START + 0, Value.maxScore)
	end
	buffer.writeu8(SendBuffer, BLOCK_START + 3, Value.defenderScore ~= nil and 1 or 0)
	if Value.defenderScore ~= nil then
		-- Allocate BLOCK: 4 bytes
		local BLOCK_START = Allocate(4)
		buffer.writei32(SendBuffer, BLOCK_START + 0, Value.defenderScore)
	end
	buffer.writeu8(SendBuffer, BLOCK_START + 4, Value.hostileScore ~= nil and 1 or 0)
	if Value.hostileScore ~= nil then
		-- Allocate BLOCK: 4 bytes
		local BLOCK_START = Allocate(4)
		buffer.writei32(SendBuffer, BLOCK_START + 0, Value.hostileScore)
	end
end

