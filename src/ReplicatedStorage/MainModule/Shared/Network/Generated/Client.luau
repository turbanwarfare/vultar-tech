	end
	local Value = {} :: any
	Value.HasAccess = (buffer.readu8(RecieveBuffer, BLOCK_START + 1) == 1)
	Value.IsPrivateServer = (buffer.readu8(RecieveBuffer, BLOCK_START + 2) == 1)
