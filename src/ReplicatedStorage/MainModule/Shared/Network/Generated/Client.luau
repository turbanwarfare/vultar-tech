function SerdesFunctions.Phase_WriteEVENT_Control(Value: { action: ("start" | "skipPhase" | "end" | "setTermTime" | "setRaidTime"), termTime: number?, raidTime: number?, winner: string? }): ()
	-- Allocate BLOCK: 5 bytes
	local BLOCK_START = Allocate(5)
	buffer.writeu8(SendBuffer, BLOCK_START + 0, 79)
	if Value.action == "start" then
		buffer.writeu8(SendBuffer, BLOCK_START + 1, 0)
	elseif Value.action == "skipPhase" then
		buffer.writeu8(SendBuffer, BLOCK_START + 1, 1)
	elseif Value.action == "end" then
		buffer.writeu8(SendBuffer, BLOCK_START + 1, 2)
	elseif Value.action == "setTermTime" then
		buffer.writeu8(SendBuffer, BLOCK_START + 1, 3)
	elseif Value.action == "setRaidTime" then
		buffer.writeu8(SendBuffer, BLOCK_START + 1, 4)
	else
		error(`Unexpected enum: {Value.action}, expected one of "start" or "skipPhase" or "end" or "setTermTime" or "setRaidTime".`)
	end
	buffer.writeu8(SendBuffer, BLOCK_START + 2, Value.termTime ~= nil and 1 or 0)
	if Value.termTime ~= nil then
		-- Allocate BLOCK: 4 bytes
		local BLOCK_START = Allocate(4)
		buffer.writef32(SendBuffer, BLOCK_START + 0, Value.termTime)
	end
	buffer.writeu8(SendBuffer, BLOCK_START + 3, Value.raidTime ~= nil and 1 or 0)
	if Value.raidTime ~= nil then
		-- Allocate BLOCK: 4 bytes
		local BLOCK_START = Allocate(4)
		buffer.writef32(SendBuffer, BLOCK_START + 0, Value.raidTime)
	end
	buffer.writeu8(SendBuffer, BLOCK_START + 4, Value.winner ~= nil and 1 or 0)
	if Value.winner ~= nil then
		-- Allocate BLOCK: 2 bytes
		local BLOCK_START = Allocate(2)
		local Length = #Value.winner
		buffer.writeu16(SendBuffer, BLOCK_START + 0, Length)
		Allocate(Length)
		buffer.writestring(SendBuffer, SendOffset, Value.winner, Length)
	end
end

