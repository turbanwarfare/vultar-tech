function SerdesFunctions.Chat_WriteFUNCTION_DATA_GetSystemHistory(Value: ("GLOBAL" | "OFFICER" | "HICOM" | "RAID" | "ROYAL" | "DREAD"), InvocationIdentifier: number): ()
