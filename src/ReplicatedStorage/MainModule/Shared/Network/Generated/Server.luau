function SerdesFunctions.Domination_WriteFUNCTION_RETURN_GetPermissions(Value: { HasAccess: boolean, IsPrivateServer: boolean, IsOwner: boolean }, InvocationIdentifier: number): ()
	-- Allocate BLOCK: 6 bytes
	local BLOCK_START = Allocate(6)
	buffer.writeu8(SendBuffer, BLOCK_START + 0, 110)
	buffer.writeu8(SendBuffer, BLOCK_START + 1, InvocationIdentifier)
	buffer.writeu8(SendBuffer, BLOCK_START + 2, 1)
	buffer.writeu8(SendBuffer, BLOCK_START + 3, Value.HasAccess and 1 or 0)
	buffer.writeu8(SendBuffer, BLOCK_START + 4, Value.IsPrivateServer and 1 or 0)
	buffer.writeu8(SendBuffer, BLOCK_START + 5, Value.IsOwner and 1 or 0)
end

function SerdesFunctions.Domination_ReadFUNCTION_DATA_GetState(): (nil)
	return nil
end

function SerdesFunctions.Domination_WriteFUNCTION_RETURN_GetState(Value: { Official: boolean, Paused: boolean, CountingDown: boolean, DefenderScore: number, HostileScore: number, MaxScore: number, Points: { { Label: string, Owner: ("Defenders" | "Hostiles")?, Progress: number, ProgressOwner: ("Defenders" | "Hostiles")?, Contested: boolean } } }, InvocationIdentifier: number): ()
	-- Allocate BLOCK: 19 bytes
	local BLOCK_START = Allocate(19)
	buffer.writeu8(SendBuffer, BLOCK_START + 0, 111)
	buffer.writeu8(SendBuffer, BLOCK_START + 1, InvocationIdentifier)
	buffer.writeu8(SendBuffer, BLOCK_START + 2, 1)
	buffer.writeu8(SendBuffer, BLOCK_START + 3, Value.Official and 1 or 0)
	buffer.writeu8(SendBuffer, BLOCK_START + 4, Value.Paused and 1 or 0)
	buffer.writeu8(SendBuffer, BLOCK_START + 5, Value.CountingDown and 1 or 0)
	buffer.writei32(SendBuffer, BLOCK_START + 6, Value.DefenderScore)
	buffer.writei32(SendBuffer, BLOCK_START + 10, Value.HostileScore)
	buffer.writei32(SendBuffer, BLOCK_START + 14, Value.MaxScore)
	-- START ARRAY
	buffer.writeu8(SendBuffer, BLOCK_START + 18, #Value.Points)
		-- Allocate BLOCK: 9 bytes
	local ARRAY_START_1 = Allocate(9 * #Value.Points)
	for Index = 1, #Value.Points do
		local Item_1 = Value.Points[Index]
		local Length = #Item_1.Label
		-- Allocate 2
		local OPERATION_OFFSET_0 = ARRAY_START_1
		ARRAY_START_1 += 2
		buffer.writeu16(SendBuffer, OPERATION_OFFSET_0, Length)
		Allocate(Length)
		buffer.writestring(SendBuffer, SendOffset, Item_1.Label, Length)
		-- Allocate 1
		local OPERATION_OFFSET_1 = ARRAY_START_1
		ARRAY_START_1 += 1
		buffer.writeu8(SendBuffer, OPERATION_OFFSET_1, Item_1.Owner ~= nil and 1 or 0)
		if Item_1.Owner ~= nil then
			-- Allocate BLOCK: 1 bytes
			local BLOCK_START = Allocate(1)
			if Item_1.Owner == "Defenders" then
				buffer.writeu8(SendBuffer, BLOCK_START + 0, 0)
			elseif Item_1.Owner == "Hostiles" then
				buffer.writeu8(SendBuffer, BLOCK_START + 0, 1)
			else
				error(`Unexpected enum: {Item_1.Owner}, expected one of "Defenders" or "Hostiles".`)
			end
		end
		-- Allocate 4
		local OPERATION_OFFSET_2 = ARRAY_START_1
		ARRAY_START_1 += 4
		buffer.writef32(SendBuffer, OPERATION_OFFSET_2, Item_1.Progress)
		-- Allocate 1
		local OPERATION_OFFSET_3 = ARRAY_START_1
		ARRAY_START_1 += 1
		buffer.writeu8(SendBuffer, OPERATION_OFFSET_3, Item_1.ProgressOwner ~= nil and 1 or 0)
		if Item_1.ProgressOwner ~= nil then
			-- Allocate BLOCK: 1 bytes
			local BLOCK_START = Allocate(1)
			if Item_1.ProgressOwner == "Defenders" then
				buffer.writeu8(SendBuffer, BLOCK_START + 0, 0)
			elseif Item_1.ProgressOwner == "Hostiles" then
				buffer.writeu8(SendBuffer, BLOCK_START + 0, 1)
			else
				error(`Unexpected enum: {Item_1.ProgressOwner}, expected one of "Defenders" or "Hostiles".`)
			end
		end
		-- Allocate 1
		local OPERATION_OFFSET_4 = ARRAY_START_1
		ARRAY_START_1 += 1
		buffer.writeu8(SendBuffer, OPERATION_OFFSET_4, Item_1.Contested and 1 or 0)
	end
	-- END ARRAY
end

