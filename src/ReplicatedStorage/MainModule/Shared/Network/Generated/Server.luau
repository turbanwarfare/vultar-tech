		-- Allocate BLOCK: 14 bytes
		local BLOCK_START = Allocate(14)
		buffer.writef64(SendBuffer, BLOCK_START + 0, Value.HostileTopPlayers.Kills.UserId)
		local Length = #Value.HostileTopPlayers.Kills.DisplayName
		buffer.writeu16(SendBuffer, BLOCK_START + 8, Length)
		Allocate(Length)
		buffer.writestring(SendBuffer, SendOffset, Value.HostileTopPlayers.Kills.DisplayName, Length)
		buffer.writei32(SendBuffer, BLOCK_START + 10, Value.HostileTopPlayers.Kills.Value)
	end
	buffer.writeu8(SendBuffer, BLOCK_START + 7, Value.HostileTopPlayers.Damage ~= nil and 1 or 0)
	if Value.HostileTopPlayers.Damage ~= nil then
		-- Allocate BLOCK: 14 bytes
		local BLOCK_START = Allocate(14)
		buffer.writef64(SendBuffer, BLOCK_START + 0, Value.HostileTopPlayers.Damage.UserId)
		local Length = #Value.HostileTopPlayers.Damage.DisplayName
		buffer.writeu16(SendBuffer, BLOCK_START + 8, Length)
		Allocate(Length)
		buffer.writestring(SendBuffer, SendOffset, Value.HostileTopPlayers.Damage.DisplayName, Length)
		buffer.writei32(SendBuffer, BLOCK_START + 10, Value.HostileTopPlayers.Damage.Value)
	end
	buffer.writeu8(SendBuffer, BLOCK_START + 8, Value.HostileTopPlayers.Heals ~= nil and 1 or 0)
	if Value.HostileTopPlayers.Heals ~= nil then
		-- Allocate BLOCK: 14 bytes
		local BLOCK_START = Allocate(14)
		buffer.writef64(SendBuffer, BLOCK_START + 0, Value.HostileTopPlayers.Heals.UserId)
		local Length = #Value.HostileTopPlayers.Heals.DisplayName
		buffer.writeu16(SendBuffer, BLOCK_START + 8, Length)
		Allocate(Length)
		buffer.writestring(SendBuffer, SendOffset, Value.HostileTopPlayers.Heals.DisplayName, Length)
		buffer.writei32(SendBuffer, BLOCK_START + 10, Value.HostileTopPlayers.Heals.Value)
	end
	buffer.writei32(SendBuffer, BLOCK_START + 9, Value.DefenderScore)
	buffer.writei32(SendBuffer, BLOCK_START + 13, Value.HostileScore)
end

function SerdesFunctions.Domination_ReadEVENT_Control(): ({ action: ("start" | "pause" | "unpause" | "reset" | "setMaxScore" | "setScores"), maxScore: number?, defenderScore: number?, hostileScore: number? })
	-- Read BLOCK: 4 bytes
	local BLOCK_START = Read(4)
	local Value = {} :: any
	Value.action = true :: any
	local Index = buffer.readu8(RecieveBuffer, BLOCK_START + 0)
	if Index == 0 then
		Value.action = "start"
	elseif Index == 1 then
		Value.action = "pause"
	elseif Index == 2 then
		Value.action = "unpause"
	elseif Index == 3 then
		Value.action = "reset"
	elseif Index == 4 then
		Value.action = "setMaxScore"
	elseif Index == 5 then
		Value.action = "setScores"
	else
		error(`Unexpected enum: {Index}`)
	end
	if buffer.readu8(RecieveBuffer, BLOCK_START + 1) == 1 then
		-- Read BLOCK: 4 bytes
		local BLOCK_START = Read(4)
		Value.maxScore = buffer.readi32(RecieveBuffer, BLOCK_START + 0)
	end
	if buffer.readu8(RecieveBuffer, BLOCK_START + 2) == 1 then
		-- Read BLOCK: 4 bytes
		local BLOCK_START = Read(4)
		Value.defenderScore = buffer.readi32(RecieveBuffer, BLOCK_START + 0)
	end
	if buffer.readu8(RecieveBuffer, BLOCK_START + 3) == 1 then
		-- Read BLOCK: 4 bytes
		local BLOCK_START = Read(4)
		Value.hostileScore = buffer.readi32(RecieveBuffer, BLOCK_START + 0)
	end
	return Value
end

