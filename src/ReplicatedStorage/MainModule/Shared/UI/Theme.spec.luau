--!nocheck
return function()
	local Theme = require(script.Parent.Theme)

	describe("Theme", function()
		describe("Colors", function()
			it("should have White color", function()
				expect(Theme.Colors.White).to.be.ok()
				expect(typeof(Theme.Colors.White)).to.equal("Color3")
			end)

			it("should have Black color scale", function()
				expect(Theme.Colors.Black).to.be.ok()
				expect(Theme.Colors.Black[950]).to.be.ok()
				expect(Theme.Colors.Black[900]).to.be.ok()
				expect(Theme.Colors.Black[50]).to.be.ok()
			end)

			it("should have Gray color scale", function()
				expect(Theme.Colors.Gray).to.be.ok()
				expect(Theme.Colors.Gray[950]).to.be.ok()
			end)

			it("should have Silver colors", function()
				expect(Theme.Colors.Silver).to.be.ok()
				expect(Theme.Colors.SilverBright).to.be.ok()
				expect(Theme.Colors.SilverMuted).to.be.ok()
			end)

			it("should have Success colors", function()
				expect(Theme.Colors.Success).to.be.ok()
				expect(Theme.Colors.SuccessHover).to.be.ok()
				expect(Theme.Colors.SuccessMuted).to.be.ok()
			end)

			it("should have Destructive colors", function()
				expect(Theme.Colors.Destructive).to.be.ok()
				expect(Theme.Colors.DestructiveHover).to.be.ok()
				expect(Theme.Colors.DestructiveMuted).to.be.ok()
			end)
		end)

		describe("Transparency", function()
			it("should have transparency values", function()
				expect(Theme.Transparency).to.be.ok()
				expect(Theme.Transparency.Solid).to.equal(0)
				expect(Theme.Transparency.Invisible).to.equal(1)
			end)

			it("should have all transparency levels", function()
				expect(typeof(Theme.Transparency.Subtle)).to.equal("number")
				expect(typeof(Theme.Transparency.Light)).to.equal("number")
				expect(typeof(Theme.Transparency.Medium)).to.equal("number")
				expect(typeof(Theme.Transparency.Heavy)).to.equal("number")
			end)
		end)

		describe("Background", function()
			it("should have background colors", function()
				expect(Theme.Background).to.be.ok()
				expect(Theme.Background.Base).to.be.ok()
				expect(Theme.Background.Primary).to.be.ok()
				expect(Theme.Background.Secondary).to.be.ok()
			end)
		end)

		describe("Foreground", function()
			it("should have foreground colors", function()
				expect(Theme.Foreground).to.be.ok()
				expect(Theme.Foreground.Primary).to.be.ok()
				expect(Theme.Foreground.Secondary).to.be.ok()
				expect(Theme.Foreground.Muted).to.be.ok()
			end)
		end)

		describe("Border", function()
			it("should have border colors", function()
				expect(Theme.Border).to.be.ok()
				expect(Theme.Border.Default).to.be.ok()
				expect(Theme.Border.Silver).to.be.ok()
			end)
		end)

		describe("Radius", function()
			it("should have radius values as UDim", function()
				expect(Theme.Radius).to.be.ok()
				expect(typeof(Theme.Radius.None)).to.equal("UDim")
				expect(typeof(Theme.Radius.Small)).to.equal("UDim")
				expect(typeof(Theme.Radius.Medium)).to.equal("UDim")
				expect(typeof(Theme.Radius.Large)).to.equal("UDim")
			end)
		end)

		describe("Spacing", function()
			it("should have spacing values as numbers", function()
				expect(Theme.Spacing).to.be.ok()
				expect(typeof(Theme.Spacing.None)).to.equal("number")
				expect(typeof(Theme.Spacing.Small)).to.equal("number")
				expect(typeof(Theme.Spacing.Medium)).to.equal("number")
				expect(typeof(Theme.Spacing.Large)).to.equal("number")
			end)
		end)

		describe("Text", function()
			it("should have text sizes", function()
				expect(Theme.Text).to.be.ok()
				expect(typeof(Theme.Text.Small)).to.equal("number")
				expect(typeof(Theme.Text.Medium)).to.equal("number")
				expect(typeof(Theme.Text.Large)).to.equal("number")
			end)

			it("should have font enums", function()
				expect(Theme.Text.Regular).to.be.ok()
				expect(Theme.Text.Bold).to.be.ok()
			end)
		end)

		describe("Spring", function()
			it("should have spring configurations", function()
				expect(Theme.Spring).to.be.ok()
				expect(Theme.Spring.Default).to.be.ok()
				expect(Theme.Spring.Default.Speed).to.be.ok()
				expect(Theme.Spring.Default.Damping).to.be.ok()
			end)
		end)

		describe("Tween", function()
			it("should have tween info", function()
				expect(Theme.Tween).to.be.ok()
				expect(typeof(Theme.Tween.Quick)).to.equal("TweenInfo")
				expect(typeof(Theme.Tween.Default)).to.equal("TweenInfo")
			end)
		end)

		describe("Chat", function()
			it("should have chat theme settings", function()
				expect(Theme.Chat).to.be.ok()
				expect(Theme.Chat.Window).to.be.ok()
				expect(Theme.Chat.Input).to.be.ok()
				expect(Theme.Chat.Tab).to.be.ok()
				expect(Theme.Chat.Message).to.be.ok()
			end)

			it("should have window settings", function()
				expect(Theme.Chat.Window.Background).to.be.ok()
				expect(typeof(Theme.Chat.Window.BackgroundTransparency)).to.equal("number")
			end)
		end)

		describe("Button", function()
			it("should have button themes", function()
				expect(Theme.Button).to.be.ok()
				expect(Theme.Button.Primary).to.be.ok()
				expect(Theme.Button.Secondary).to.be.ok()
				expect(Theme.Button.Destructive).to.be.ok()
			end)
		end)

		describe("Navbar", function()
			it("should have navbar settings", function()
				expect(Theme.Navbar).to.be.ok()
				expect(Theme.Navbar.Tab).to.be.ok()
			end)
		end)

		describe("Inventory", function()
			it("should have inventory slot settings", function()
				expect(Theme.Inventory).to.be.ok()
				expect(Theme.Inventory.Slot).to.be.ok()
				expect(Theme.Inventory.Slot.Background).to.be.ok()
			end)
		end)

		describe("Row", function()
			it("should have row settings", function()
				expect(Theme.Row).to.be.ok()
				expect(Theme.Row.Background).to.be.ok()
				expect(typeof(Theme.Row.BackgroundTransparency)).to.equal("number")
			end)
		end)

		describe("Modal", function()
			it("should have modal settings", function()
				expect(Theme.Modal).to.be.ok()
				expect(Theme.Modal.Background).to.be.ok()
				expect(Theme.Modal.Overlay).to.be.ok()
			end)
		end)

		describe("Shop", function()
			it("should have shop settings", function()
				expect(Theme.Shop).to.be.ok()
				expect(Theme.Shop.Header).to.be.ok()
				expect(Theme.Shop.Card).to.be.ok()
			end)
		end)
	end)
end
