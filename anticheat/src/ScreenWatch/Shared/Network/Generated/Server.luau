			ARRAY_START_2 += 4
			buffer.writef32(SendBuffer, OPERATION_OFFSET_6, rZ)
		end
		-- END ARRAY
		-- Allocate 8
		local OPERATION_OFFSET_1 = ARRAY_START_1
