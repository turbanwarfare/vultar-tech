function SerdesFunctions.ScreenWatch_WriteEVENT_PreBufferChunk(Value: { cameras: { { cframe: CFrame, fov: number, viewportSize: { X: number, Y: number }, mouseHit: Vector3, timestamp: number, mouseBehavior: ("Default" | "LockCenter" | "LockCurrentPosition"), isSprinting: boolean?, isCrouching: boolean?, ping: number?, avgPing: number?, pingSpikes: number?, matchAccuracy: number? } }, cursors: { { position: { X: number, Y: number }, timestamp: number, icon: string? } }, ghosts: { { ghosts: { { characterId: number, cframe: CFrame } }, timestamp: number } } }): ()
	-- Allocate BLOCK: 4 bytes
	local BLOCK_START = Allocate(4)
	buffer.writeu8(SendBuffer, BLOCK_START + 0, 12)
	-- START ARRAY
	buffer.writeu8(SendBuffer, BLOCK_START + 1, #Value.cameras)
		-- Allocate BLOCK: 63 bytes
	local ARRAY_START_1 = Allocate(63 * #Value.cameras)
	for Index = 1, #Value.cameras do
		local Item_1 = Value.cameras[Index]
		local Vector = Item_1.cframe.Position
		-- Allocate 4
		local OPERATION_OFFSET_0 = ARRAY_START_1
		ARRAY_START_1 += 4
		buffer.writef32(SendBuffer, OPERATION_OFFSET_0, Vector.X)
		-- Allocate 4
		local OPERATION_OFFSET_1 = ARRAY_START_1
		ARRAY_START_1 += 4
		buffer.writef32(SendBuffer, OPERATION_OFFSET_1, Vector.Y)
		-- Allocate 4
		local OPERATION_OFFSET_2 = ARRAY_START_1
		ARRAY_START_1 += 4
		buffer.writef32(SendBuffer, OPERATION_OFFSET_2, Vector.Z)
		local rX, rY, rZ = Item_1.cframe:ToOrientation()
		-- Allocate 4
		local OPERATION_OFFSET_3 = ARRAY_START_1
		ARRAY_START_1 += 4
		buffer.writef32(SendBuffer, OPERATION_OFFSET_3, rX)
		-- Allocate 4
		local OPERATION_OFFSET_4 = ARRAY_START_1
		ARRAY_START_1 += 4
		buffer.writef32(SendBuffer, OPERATION_OFFSET_4, rY)
		-- Allocate 4
		local OPERATION_OFFSET_5 = ARRAY_START_1
		ARRAY_START_1 += 4
		buffer.writef32(SendBuffer, OPERATION_OFFSET_5, rZ)
		-- Allocate 4
		local OPERATION_OFFSET_6 = ARRAY_START_1
		ARRAY_START_1 += 4
		buffer.writef32(SendBuffer, OPERATION_OFFSET_6, Item_1.fov)
		-- Allocate 4
		local OPERATION_OFFSET_7 = ARRAY_START_1
		ARRAY_START_1 += 4
		buffer.writef32(SendBuffer, OPERATION_OFFSET_7, Item_1.viewportSize.X)
		-- Allocate 4
		local OPERATION_OFFSET_8 = ARRAY_START_1
		ARRAY_START_1 += 4
		buffer.writef32(SendBuffer, OPERATION_OFFSET_8, Item_1.viewportSize.Y)
		local Vector = Item_1.mouseHit
		-- Allocate 4
		local OPERATION_OFFSET_9 = ARRAY_START_1
		ARRAY_START_1 += 4
		buffer.writef32(SendBuffer, OPERATION_OFFSET_9, Vector.X)
		-- Allocate 4
		local OPERATION_OFFSET_10 = ARRAY_START_1
		ARRAY_START_1 += 4
		buffer.writef32(SendBuffer, OPERATION_OFFSET_10, Vector.Y)
		-- Allocate 4
		local OPERATION_OFFSET_11 = ARRAY_START_1
		ARRAY_START_1 += 4
		buffer.writef32(SendBuffer, OPERATION_OFFSET_11, Vector.Z)
		-- Allocate 8
		local OPERATION_OFFSET_12 = ARRAY_START_1
		ARRAY_START_1 += 8
		buffer.writef64(SendBuffer, OPERATION_OFFSET_12, Item_1.timestamp)
		-- Allocate 1
		local OPERATION_OFFSET_13 = ARRAY_START_1
		ARRAY_START_1 += 1
		if Item_1.mouseBehavior == "Default" then
			buffer.writeu8(SendBuffer, OPERATION_OFFSET_13, 0)
		elseif Item_1.mouseBehavior == "LockCenter" then
			buffer.writeu8(SendBuffer, OPERATION_OFFSET_13, 1)
		elseif Item_1.mouseBehavior == "LockCurrentPosition" then
			buffer.writeu8(SendBuffer, OPERATION_OFFSET_13, 2)
		else
			error(`Unexpected enum: {Item_1.mouseBehavior}, expected one of "Default" or "LockCenter" or "LockCurrentPosition".`)
		end
		-- Allocate 1
		local OPERATION_OFFSET_14 = ARRAY_START_1
		ARRAY_START_1 += 1
		buffer.writeu8(SendBuffer, OPERATION_OFFSET_14, Item_1.isSprinting ~= nil and 1 or 0)
		if Item_1.isSprinting ~= nil then
			-- Allocate BLOCK: 1 bytes
			local BLOCK_START = Allocate(1)
			buffer.writeu8(SendBuffer, BLOCK_START + 0, Item_1.isSprinting and 1 or 0)
		end
		-- Allocate 1
		local OPERATION_OFFSET_15 = ARRAY_START_1
		ARRAY_START_1 += 1
		buffer.writeu8(SendBuffer, OPERATION_OFFSET_15, Item_1.isCrouching ~= nil and 1 or 0)
		if Item_1.isCrouching ~= nil then
			-- Allocate BLOCK: 1 bytes
			local BLOCK_START = Allocate(1)
			buffer.writeu8(SendBuffer, BLOCK_START + 0, Item_1.isCrouching and 1 or 0)
		end
		-- Allocate 1
		local OPERATION_OFFSET_16 = ARRAY_START_1
		ARRAY_START_1 += 1
		buffer.writeu8(SendBuffer, OPERATION_OFFSET_16, Item_1.ping ~= nil and 1 or 0)
		if Item_1.ping ~= nil then
			-- Allocate BLOCK: 2 bytes
			local BLOCK_START = Allocate(2)
			buffer.writeu16(SendBuffer, BLOCK_START + 0, Item_1.ping)
		end
		-- Allocate 1
		local OPERATION_OFFSET_17 = ARRAY_START_1
		ARRAY_START_1 += 1
		buffer.writeu8(SendBuffer, OPERATION_OFFSET_17, Item_1.avgPing ~= nil and 1 or 0)
		if Item_1.avgPing ~= nil then
			-- Allocate BLOCK: 2 bytes
			local BLOCK_START = Allocate(2)
			buffer.writeu16(SendBuffer, BLOCK_START + 0, Item_1.avgPing)
		end
		-- Allocate 1
		local OPERATION_OFFSET_18 = ARRAY_START_1
		ARRAY_START_1 += 1
		buffer.writeu8(SendBuffer, OPERATION_OFFSET_18, Item_1.pingSpikes ~= nil and 1 or 0)
		if Item_1.pingSpikes ~= nil then
			-- Allocate BLOCK: 2 bytes
			local BLOCK_START = Allocate(2)
			buffer.writeu16(SendBuffer, BLOCK_START + 0, Item_1.pingSpikes)
		end
		-- Allocate 1
		local OPERATION_OFFSET_19 = ARRAY_START_1
		ARRAY_START_1 += 1
		buffer.writeu8(SendBuffer, OPERATION_OFFSET_19, Item_1.matchAccuracy ~= nil and 1 or 0)
		if Item_1.matchAccuracy ~= nil then
			-- Allocate BLOCK: 4 bytes
			local BLOCK_START = Allocate(4)
			buffer.writef32(SendBuffer, BLOCK_START + 0, Item_1.matchAccuracy)
		end
	end
	-- END ARRAY
	-- START ARRAY
	buffer.writeu8(SendBuffer, BLOCK_START + 2, #Value.cursors)
		-- Allocate BLOCK: 17 bytes
	local ARRAY_START_1 = Allocate(17 * #Value.cursors)
	for Index = 1, #Value.cursors do
		local Item_1 = Value.cursors[Index]
		-- Allocate 4
		local OPERATION_OFFSET_0 = ARRAY_START_1
		ARRAY_START_1 += 4
		buffer.writef32(SendBuffer, OPERATION_OFFSET_0, Item_1.position.X)
		-- Allocate 4
		local OPERATION_OFFSET_1 = ARRAY_START_1
		ARRAY_START_1 += 4
		buffer.writef32(SendBuffer, OPERATION_OFFSET_1, Item_1.position.Y)
		-- Allocate 8
		local OPERATION_OFFSET_2 = ARRAY_START_1
		ARRAY_START_1 += 8
		buffer.writef64(SendBuffer, OPERATION_OFFSET_2, Item_1.timestamp)
		-- Allocate 1
		local OPERATION_OFFSET_3 = ARRAY_START_1
		ARRAY_START_1 += 1
		buffer.writeu8(SendBuffer, OPERATION_OFFSET_3, Item_1.icon ~= nil and 1 or 0)
		if Item_1.icon ~= nil then
			-- Allocate BLOCK: 2 bytes
			local BLOCK_START = Allocate(2)
			local Length = #Item_1.icon
			buffer.writeu16(SendBuffer, BLOCK_START + 0, Length)
			Allocate(Length)
			buffer.writestring(SendBuffer, SendOffset, Item_1.icon, Length)
		end
	end
	-- END ARRAY
	-- START ARRAY
	buffer.writeu8(SendBuffer, BLOCK_START + 3, #Value.ghosts)
		-- Allocate BLOCK: 9 bytes
	local ARRAY_START_1 = Allocate(9 * #Value.ghosts)
	for Index = 1, #Value.ghosts do
		local Item_1 = Value.ghosts[Index]
		-- START ARRAY
		-- Allocate 1
		local OPERATION_OFFSET_0 = ARRAY_START_1
		ARRAY_START_1 += 1
		buffer.writeu8(SendBuffer, OPERATION_OFFSET_0, #Item_1.ghosts)
			-- Allocate BLOCK: 32 bytes
		local ARRAY_START_2 = Allocate(32 * #Item_1.ghosts)
		for Index = 1, #Item_1.ghosts do
			local Item_2 = Item_1.ghosts[Index]
			-- Allocate 8
			local OPERATION_OFFSET_0 = ARRAY_START_2
			ARRAY_START_2 += 8
			buffer.writef64(SendBuffer, OPERATION_OFFSET_0, Item_2.characterId)
			local Vector = Item_2.cframe.Position
			-- Allocate 4
			local OPERATION_OFFSET_1 = ARRAY_START_2
			ARRAY_START_2 += 4
			buffer.writef32(SendBuffer, OPERATION_OFFSET_1, Vector.X)
			-- Allocate 4
			local OPERATION_OFFSET_2 = ARRAY_START_2
			ARRAY_START_2 += 4
			buffer.writef32(SendBuffer, OPERATION_OFFSET_2, Vector.Y)
			-- Allocate 4
			local OPERATION_OFFSET_3 = ARRAY_START_2
			ARRAY_START_2 += 4
			buffer.writef32(SendBuffer, OPERATION_OFFSET_3, Vector.Z)
			local rX, rY, rZ = Item_2.cframe:ToOrientation()
			-- Allocate 4
			local OPERATION_OFFSET_4 = ARRAY_START_2
			ARRAY_START_2 += 4
			buffer.writef32(SendBuffer, OPERATION_OFFSET_4, rX)
			-- Allocate 4
			local OPERATION_OFFSET_5 = ARRAY_START_2
			ARRAY_START_2 += 4
			buffer.writef32(SendBuffer, OPERATION_OFFSET_5, rY)
			-- Allocate 4
