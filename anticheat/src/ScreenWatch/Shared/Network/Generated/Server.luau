function SerdesFunctions.ScreenWatch_ReadEVENT_AimSample(): (number, Vector3, Vector3)
	-- Read BLOCK: 32 bytes
	local BLOCK_START = Read(32)
	local Value1 = buffer.readf64(RecieveBuffer, BLOCK_START + 0)
	local X = buffer.readf32(RecieveBuffer, BLOCK_START + 8)
	local Y = buffer.readf32(RecieveBuffer, BLOCK_START + 12)
	local Z = buffer.readf32(RecieveBuffer, BLOCK_START + 16)
	local Value2 = Vector3.new(X, Y, Z)
	X = buffer.readf32(RecieveBuffer, BLOCK_START + 20)
	Y = buffer.readf32(RecieveBuffer, BLOCK_START + 24)
	Z = buffer.readf32(RecieveBuffer, BLOCK_START + 28)
	local Value3 = Vector3.new(X, Y, Z)
	return Value1, Value2, Value3
end

