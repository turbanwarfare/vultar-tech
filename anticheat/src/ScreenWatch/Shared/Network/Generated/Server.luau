				if #Queue.Reliable[2] > 256 then
					warn("[Blink]: Event queue of \"KeyHistoryEventTarget\" exceeded 256, did you forget to implement a listener?")
				end
				table.insert(Queue.Reliable[2], {Player, Value} :: {any})
			end
		elseif Index == 4 then
			local Value: number = SerdesFunctions.ScreenWatch_ReadEVENT_SubscribeWatch()
			if Events.Reliable[4] ~= nil then
				task.spawn(Events.Reliable[4], Player, Value)
			else
				if #Queue.Reliable[4] > 256 then
					warn("[Blink]: Event queue of \"SubscribeWatch\" exceeded 256, did you forget to implement a listener?")
				end
				table.insert(Queue.Reliable[4], {Player, Value} :: {any})
			end
		elseif Index == 5 then
			local Value: number = SerdesFunctions.ScreenWatch_ReadEVENT_UnsubscribeWatch()
			if Events.Reliable[5] ~= nil then
				task.spawn(Events.Reliable[5], Player, Value)
			else
				if #Queue.Reliable[5] > 256 then
					warn("[Blink]: Event queue of \"UnsubscribeWatch\" exceeded 256, did you forget to implement a listener?")
				end
				table.insert(Queue.Reliable[5], {Player, Value} :: {any})
			end
		elseif Index == 8 then
			local Value: nil = SerdesFunctions.ScreenWatch_ReadEVENT_ClientReady()
