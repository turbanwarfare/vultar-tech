	-- Allocate BLOCK: 36 bytes
	local BLOCK_START = Allocate(36)
	buffer.writeu8(SendBuffer, BLOCK_START + 0, 10)
	buffer.writef64(SendBuffer, BLOCK_START + 1, Value.targetUserId)
	buffer.writef64(SendBuffer, BLOCK_START + 9, Value.victimId)
	local Length = #Value.victimName
	buffer.writeu16(SendBuffer, BLOCK_START + 17, Length)
	Allocate(Length)
	buffer.writestring(SendBuffer, SendOffset, Value.victimName, Length)
	buffer.writeu16(SendBuffer, BLOCK_START + 19, Value.damage)
	local Length = #Value.bodyPart
	buffer.writeu16(SendBuffer, BLOCK_START + 21, Length)
	Allocate(Length)
	buffer.writestring(SendBuffer, SendOffset, Value.bodyPart, Length)
	buffer.writeu8(SendBuffer, BLOCK_START + 23, Value.isHeadshot and 1 or 0)
	local Length = #Value.weaponName
	buffer.writeu16(SendBuffer, BLOCK_START + 24, Length)
	Allocate(Length)
	buffer.writestring(SendBuffer, SendOffset, Value.weaponName, Length)
	buffer.writef64(SendBuffer, BLOCK_START + 26, Value.timestamp)
	buffer.writeu8(SendBuffer, BLOCK_START + 34, Value.hitOffset ~= nil and 1 or 0)
	if Value.hitOffset ~= nil then
		-- Allocate BLOCK: 12 bytes
		local BLOCK_START = Allocate(12)
		local Vector = Value.hitOffset
		buffer.writef32(SendBuffer, BLOCK_START + 0, Vector.X)
		buffer.writef32(SendBuffer, BLOCK_START + 4, Vector.Y)
		buffer.writef32(SendBuffer, BLOCK_START + 8, Vector.Z)
	end
	buffer.writeu8(SendBuffer, BLOCK_START + 35, Value.targetTime ~= nil and 1 or 0)
	if Value.targetTime ~= nil then
		-- Allocate BLOCK: 8 bytes
		local BLOCK_START = Allocate(8)
		buffer.writef64(SendBuffer, BLOCK_START + 0, Value.targetTime)
	end
end

